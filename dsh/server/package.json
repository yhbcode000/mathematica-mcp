{
  "name": "mathematica-mcp",
  "version": "0.1.1",
  "description": "MCP server that exposes a local Wolfram Mathematica kernel over stdio: evaluate Wolfram Language code in a persistent kernel and export PNG/SVG/PDF/CSV/TXT/JSON/TEX files.",
  "type": "module",
  "bin": {
    "mathematica-mcp": "./bin/mathematica-mcp.js"
  },
  "main": "./src/server.js",
  "exports": {
    ".": "./src/server.js",
    "./kernel": "./src/kernel.js",
    "./detect": "./src/detect.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/mathematica-mcp.js",
    "test": "node --test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mathematica",
    "wolfram",
    "wolfram-language",
    "wolfram-engine",
    "ai",
    "llm",
    "tools",
    "stdio"
  ],
  "license": "MIT",
  "dependencies": {}
}
